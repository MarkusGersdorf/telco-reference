---
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: dns-vlan
  namespace: dns
spec:
  config: >-
    {
      "cniVersion": "0.3.1",
      "type": "macvlan",
      "master": "bond0.{{ networking.dns_network.vlan_id }}",
      "mode": "bridge",
      "ipam": {
        "type": "whereabouts",
        "range": "{{ networking.dns_network.cidr }}",
        "exclude": ["{{ networking.dns_network.vip }}/32"]
      }
    }
