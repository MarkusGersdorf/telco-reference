---
apiVersion: v1
kind: Namespace
metadata:
  name: dns
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: dns-server
  namespace: dns
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dns-named-conf
  namespace: dns
data:
  hbird-defaults.conf: |
    options {
        directory "/var/named";
        pid-file none;
        session-keyfile none;

        listen-on port 53 { any; };
        listen-on-v6 port 53 { none; };

        recursion yes;
        allow-recursion { any; };
        dnssec-validation no;
        minimal-any yes;
        max-cache-size 128m;

        forwarders {
{% for fwd in networking.dns_forwarders | default(['8.8.8.8', '8.8.4.4']) %}
            {{ fwd }};
{% endfor %}
        };
        forward only;
    };

    controls { };

{% for zone in dns_zones %}
    zone "{{ zone }}" IN {
        type primary;
        file "/var/named/zones/{{ zone }}.zone";
    };
{% endfor %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dns-zones
  namespace: dns
data:
{% for zone in dns_zones %}
  {{ zone }}.zone: |
    $TTL 86400
    @   IN  SOA ns1.{{ zone }}. admin.{{ zone }}. (
                2025010101  ; serial
                3600        ; refresh
                1800        ; retry
                604800      ; expire
                86400       ; minimum TTL
            )
    @       IN  NS  ns1
    ns1     IN  A   {{ networking.dns_network.vip }}
{% if zone == cluster.name + '.' + cluster.base_domain %}
    api     IN  A   {{ networking.api_vip }}
    api-int IN  A   {{ networking.api_vip }}
    *.apps  IN  A   {{ networking.ingress_vip }}
{% for host in hosts %}
    {{ host.hostname }}    IN  A   {{ host.ip }}
{% endfor %}
{% for record in networking.extra_dns_records | default([]) %}
    {{ record.name }}    IN  {{ record.type }}   {{ record.value }}
{% endfor %}
{% endif %}
{% endfor %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: keepalived-config
  namespace: dns
data:
  keepalived.conf: |
    vrrp_instance DNS_VIP {
        interface net1
        state BACKUP
        virtual_router_id 53
        priority 100
        advert_int 1
        virtual_ipaddress {
            {{ networking.dns_network.vip }}/{{ networking.dns_network.cidr.split('/')[1] }}
        }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dns-server
  namespace: dns
spec:
  replicas: 3
  selector:
    matchLabels:
      app: dns-server
  template:
    metadata:
      labels:
        app: dns-server
      annotations:
        k8s.v1.cni.cncf.io/networks: dns-vlan
    spec:
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchExpressions:
                  - key: app
                    operator: In
                    values:
                      - dns-server
              topologyKey: kubernetes.io/hostname
      serviceAccountName: dns-server
      containers:
        - name: bind
          image: registry.access.redhat.com/hi/bind:latest
          securityContext:
            runAsUser: 25
            runAsGroup: 25
            capabilities:
              add:
                - NET_BIND_SERVICE
          ports:
            - name: dns-udp
              containerPort: 53
              protocol: UDP
            - name: dns-tcp
              containerPort: 53
              protocol: TCP
          volumeMounts:
            - name: config
              mountPath: /etc/named/hbird-defaults.conf
              subPath: hbird-defaults.conf
              readOnly: true
            - name: zones
              mountPath: /var/named/zones
              readOnly: true
          readinessProbe:
            tcpSocket:
              port: 53
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: 53
            initialDelaySeconds: 10
            periodSeconds: 30
          resources:
            limits:
              cpu: "250m"
              memory: "256Mi"
            requests:
              cpu: "100m"
              memory: "128Mi"
        - name: keepalived
          image: registry.redhat.io/openshift4/ose-keepalived-ipfailover-rhel9:v4.22
          command: ["/usr/sbin/keepalived", "--dont-fork", "--log-console", "-f", "/etc/keepalived/keepalived.conf"]
          securityContext:
            runAsUser: 0
            capabilities:
              add:
                - NET_ADMIN
                - NET_RAW
          volumeMounts:
            - name: keepalived-config
              mountPath: /etc/keepalived
              readOnly: true
          resources:
            limits:
              cpu: "50m"
              memory: "64Mi"
            requests:
              cpu: "10m"
              memory: "32Mi"
      volumes:
        - name: config
          configMap:
            name: dns-named-conf
            defaultMode: 0444
        - name: zones
          configMap:
            name: dns-zones
            defaultMode: 0444
        - name: keepalived-config
          configMap:
            name: keepalived-config
