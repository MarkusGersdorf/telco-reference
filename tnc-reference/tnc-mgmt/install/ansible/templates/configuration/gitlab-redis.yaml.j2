---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gitlab-redis
  namespace: gitlab-system
spec:
  replicas: 1
  selector:
    matchLabels:
      app: gitlab-redis
  template:
    metadata:
      labels:
        app: gitlab-redis
    spec:
      containers:
        - name: redis
          image: {{ configuration.gitlab.redis_deployment.image }}:{{ configuration.gitlab.redis_deployment.image_tag }}
          ports:
            - containerPort: 6379
          env:
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ configuration.gitlab.redis.secret }}
                  key: {{ configuration.gitlab.redis.secret_key }}
          livenessProbe:
            tcpSocket:
              port: 6379
            initialDelaySeconds: 30
            periodSeconds: 10
          readinessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - redis-cli -a $REDIS_PASSWORD ping | grep PONG
            initialDelaySeconds: 5
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: {{ configuration.gitlab.redis.host }}
  namespace: gitlab-system
spec:
  selector:
    app: gitlab-redis
  ports:
    - port: 6379
      targetPort: 6379
