---
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultConnection
metadata:
  name: default
  namespace: gitlab-system
spec:
  address: http://vault.vault.svc:8200
---
apiVersion: secrets.hashicorp.com/v1beta1
kind: VaultAuth
metadata:
  name: default
  namespace: gitlab-system
spec:
  method: kubernetes
  mount: kubernetes
  kubernetes:
    role: gitlab-secrets-operator
    serviceAccount: default
    audiences:
      - vault
  vaultConnectionRef: default
